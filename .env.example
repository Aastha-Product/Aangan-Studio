# Copy to .env and fill in. Never commit .env.
# The same names go into Vercel (Project → Settings → Environment Variables) and the voice host.

# --- AI ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=            # Claude runs the conversation (voice host + local simulators)
CLAUDE_MODEL=                 # optional, default claude-opus-5-5
CLAUDE_EFFORT=                # optional, default low (live phone chat)
GEMINI_API_KEY=               # field extraction after each call (qualification)
GEMINI_MODEL=                 # optional, default gemini-3.8-flash

# --- Vaani Labs (phone) ------------------------------------------------------------
VAANI_API_KEY=                # vaani_… (api.vaanivoice.ai, X-API-Key header)
VAANI_AGENT_ID=               # written by scripts/setup_vaani_agent.py sync
VAANI_WEBHOOK_SECRET=         # long random string; webhook URL is /api/vaani/webhook?key=<this>
VOICE_SERVER_TOKEN=           # long random string; paste into Vaani's BYOL "Auth Token" field

# --- Booking calendar: Cal.com (default when CALCOM_API_KEY is set) or Calendly ----------
BOOKING_PROVIDER=              # calcom | calendly
CALCOM_API_KEY=                # cal_live_… (Cal.com → Settings → Developer → API keys)
CALCOM_EVENT_TYPE_ID=          # scripts/setup_calcom.py create-event-type --studio-address "…"
CALCOM_WEBHOOK_SECRET=         # generated; scripts/setup_calcom.py create-webhook registers it

# --- Calendly (paid plan for booking; Standard+ for webhooks) -----------------------
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=      # scripts/setup_calendly.py list-event-types
CALENDLY_WEBHOOK_SIGNING_KEY= # printed by scripts/setup_calendly.py create-webhook
SLOT_LOOKAHEAD_DAYS=          # optional, default 14

# --- Email (Resend) ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. Aangan Studio Agent <agent@aanganstudio.in>  (verified domain)
DESIGNER_EMAILS=              # comma-separated; get the 7pm digest; first one is the report-card fallback
STUDIO_HEAD_ALERT_EMAIL=      # instant escalations
FRONT_DESK_EMAIL=             # booking_pending / cancellations / no-shows (defaults to studio head)

# --- HubSpot -----------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=         # private app: crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_PIPELINE_ID=          # optional, default "default"
HUBSPOT_DEAL_STAGE_CONSULTATION_BOOKED=   # stage id of "Consultation booked"
HUBSPOT_PORTAL_ID=            # optional: your HubSpot account id, makes deal ids on the dashboard clickable

# --- Supabase ---------------------------------------------------------------------------
NEON_API_KEY=                  # Neon console → Account settings → API keys (setup_neon.py only)
DATABASE_URL=                  # written by scripts/setup_neon.py (pooled Neon connection)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=         # run db/schema.sql once in the SQL editor

# --- App -----------------------------------------------------------------------------------
PUBLIC_BASE_URL=              # e.g. https://aangan-agent.vercel.app
APP_SECRET=                   # long random string; signs the designer "re-ask" link
DASHBOARD_TOKEN=              # long random string; open /dashboard?token=...
CRON_SECRET=                  # long random string; Vercel cron sends it to /api/cron/digest

# --- Cost rates for the dashboard (fill from your plans; leave blank and the dashboard says what's missing)
COST_VAANI_INR_PER_MIN=
COST_GEMINI_USD_PER_MTOK_IN=
COST_GEMINI_USD_PER_MTOK_OUT=
COST_EMAIL_INR_EACH=          # 0 on Resend's free tier
USD_INR_RATE=
